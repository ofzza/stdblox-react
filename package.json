{
  "name": "@ofzza/stdblox-react",
  "version": "0.1.0",
  "description": "Standard library of React components, hooks and utilities, for more specialised React component libraries to build on",
  "keywords": [
    "react",
    "components",
    "hooks",
    "headless",
    "utilities"
  ],
  "homepage": "https://github.com/ofzza/stdblox-react#readme",
  "bugs": {
    "url": "https://github.com/ofzza/stdblox-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofzza/stdblox-react.git"
  },
  "license": "MIT",
  "author": "ofzza",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:preview": "vite preview --config showcase/vite.config.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "ci": "npm-run-all ci:*",
    "ci:build": "tsc -p tsconfig.build.json",
    "ci:typecheck-showcase": "tsc -p showcase/tsconfig.json",
    "ci:build-showcase": "npm-run-all showcase:build",
    "ci:eslint": "eslint src showcase scripts",
    "ci:prettier": "prettier --check src showcase scripts",
    "ci:test-unit": "npm-run-all test:unit",
    "ci:test-showcase": "npm-run-all test:showcase",
    "test": "npm-run-all test:*",
    "test:unit": "vitest run --passWithNoTests --project \"unit*\"",
    "test:showcase": "vitest run --passWithNoTests --project showcase",
    "prepare": "npm-run-all react-versions:install build",
    "prepublishOnly": "npm run ci",
    "react-versions:install": "node scripts/react-versions.mjs install"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
